generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MenuItem {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  category     String
  image        String
  pricePesewas Int?
  variants     Json     @default("[]")
  available    Boolean  @default(true)
  featured     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id                         Int      @id @default(1)
  restaurantName             String   @default("Titanic City Ventures")
  tagline                    String   @default("A Place to Be!")
  heroTitle                  String   @default("Accra's table, turned all the way up.")
  heroSubtitle               String   @default("Bold Ghanaian favourites, grills, rice dishes and more — ordered online and delivered across our Accra service area.")
  phone                      String   @default("+233 54 324 5511")
  whatsapp                   String   @default("")
  address                    String   @default("Titanic Beach, Tema, Ghana")
  restaurantPlaceId          String   @default("ChIJE7EZ2K-H3w8R8efP8YXbK-w")
  restaurantLat              Float?
  restaurantLng              Float?
  deliveryBaseFeePesewas     Int?     @default(400)
  deliveryPerKmPesewas       Int?     @default(150)
  deliveryPerMinutePesewas   Int?     @default(10)
  deliveryMinimumFeePesewas  Int?     @default(1000)
  deliveryTrafficWeight      Float    @default(0.6)
  deliveryTrafficCap         Float    @default(1.25)
  deliverySurgeMultiplier    Float    @default(1.0)
  deliveryRoundToPesewas     Int      @default(100)
  maxDeliveryKm              Float?   @default(25)
  serviceMinLat              Float    @default(5.45)
  serviceMaxLat              Float    @default(5.75)
  serviceMinLng              Float    @default(-0.35)
  serviceMaxLng              Float    @default(-0.05)
  ordersEnabled              Boolean  @default(true)
  updatedAt                  DateTime @updatedAt
}

model Asset {
  id          String   @id @default(cuid())
  fileName    String
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}

model Order {
  id                  String   @id @default(cuid())
  code                String   @unique
  customerName        String
  email               String
  phone               String
  deliveryAddress     String
  deliveryLat         Float
  deliveryLng         Float
  distanceKm                 Float
  deliveryDurationMinutes    Float?
  deliveryPricingMultiplier  Float?
  deliveryFeePesewas         Int
  subtotalPesewas     Int
  totalPesewas        Int
  items               Json
  status              String   @default("AWAITING_PAYMENT")
  paymentStatus       String   @default("PENDING")
  paystackReference   String?  @unique
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
